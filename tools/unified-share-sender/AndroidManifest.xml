<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="qa.unifiedshare.sender">
  <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />
  <application android:label="Synthetic PDF sender" android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <activity android:name=".SenderActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <provider android:name=".PdfProvider" android:authorities="qa.unifiedshare.sender.files" android:exported="false" android:grantUriPermissions="true" />
  </application>
</manifest>
