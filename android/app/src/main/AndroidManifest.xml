<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Mizel recorder: retry uploads the moment the network returns; network-constrained upload job. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Mizel recorder: a partial wake lock keeps capture going with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Wizard Everywhere: the floating button over other apps (switched on in Settings). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Native parity (0.7.0): background orb recorder, in-app update. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Hands-free updates: once Wizard OS installed itself, Android installs its later versions without asking
         (API 31+); the background check only downloads on unmetered networks. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android Apps (optional Wizard app): Wizard OS installs open-source apps James asks for and becomes their
         update owner (API 34+), so later versions install silently; uninstall goes through Android's own dialog. -->
    <uses-permission android:name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Android Apps lists what has a launcher icon (no QUERY_ALL_PACKAGES) and can open Google Play. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.android.vending" />
        <!-- Usuals: see and open Grab. -->
        <package android:name="com.grabtaxi.passenger" />
    </queries>

    <application
        android:networkSecurityConfig="@xml/wos_network"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
                android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WizardOS"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Assistant handoff: the side-key assistant opens Wizard OS listening, or with words as a draft. -->
            <intent-filter>
                <action android:name="ai.wizards.os.action.LISTEN" />
                <action android:name="ai.wizards.os.action.SAY" />
                <action android:name="ai.wizards.os.action.SIDE_BUTTON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Opening a Wizard OS link lands in the app rather than a browser tab. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="wizard.tailc0f369.ts.net" android:pathPrefix="/wizard-os-home/" />
                <data android:scheme="https" android:host="wizard.tailc0f369.ts.net" android:pathPrefix="/mizel-live/" />
                <!-- Retired name, still honoured: old links and notifications land on the same page under the tailnet name. -->
                <data android:scheme="https" android:host="private.wizard001.com" android:pathPrefix="/wizard-os-home/" />
                <data android:scheme="https" android:host="private.wizard001.com" android:pathPrefix="/mizel-live/" />
            </intent-filter>
        </activity>

        <!-- ===== Side-button assistant (feature/side-button-assistant) =====
             Hold the side button: locked phone = full Wizard over the real keyguard (showWhenLocked);
             unlocked phone = a small orb in the corner, in Android's own assistant window, so the
             app underneath keeps every touch outside the orb. Requires Wizard OS as the
             digital assistant app (Settings > Apps > Default apps > Digital assistant app). -->
        <activity
            android:name=".assist.AssistLockActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="ai.wizards.os.assist"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.WizardOS.AssistSurface">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".assist.AssistSetupActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="Side button"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".assist.WizardVoiceService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data android:name="android.voice_interaction" android:resource="@xml/assist_voice" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service
            android:name=".assist.WizardSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service
            android:name=".assist.WizardRecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data android:name="android.speech" android:resource="@xml/assist_recognition" />
        </service>
        <service
            android:name=".everywhere.EverywhereService"
            android:exported="false"
            android:foregroundServiceType="microphone|specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent user-controlled floating assistant button" />
        </service>
        <receiver
            android:name=".everywhere.EverywhereService$RetryReceiver"
            android:exported="false" />
        <service
            android:name=".everywhere.WizardKeyboardService"
            android:exported="true"
            android:label="Wizard OS voice typing"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/everywhere_accessibility" />
        </service>
        <!-- ===== Mizel meeting recorder (feature/mizel-recorder) =====
             Captures the phone mic in 5 s WAV chunks while a meeting records; uploads them through a durable
             outbox; Pause releases the mic. Started only from the app (page bridge) while it is in front. -->
        <service
            android:name=".mizel.MeetingRecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="false" />
        <service
            android:name=".mizel.MizelUploadJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".everywhere.EverywhereBoot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ===== Native parity (0.7.0) ===== -->
        <!-- Orb recorder: keeps recording with the screen off or the app in the background (Stop/Send notification). -->
        <service
            android:name=".recording.RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="false" />
        <!-- Share to Wizard from any app: text, images, files. -->
        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="ai.wizards.os.share"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- Reply-ready notifications: backstop poll after the app process is gone. -->
        <service
            android:name=".notify.ReplyJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- In-app update: PackageInstaller session results (Android's confirm screen, success, failures). -->
        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />
        <!-- Reboot: keep the update check scheduled. Updated: reopen Wizard OS if James was in it. -->
        <receiver
            android:name=".update.UpdateBoot"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Background update check (unmetered network, every few hours). -->
        <service
            android:name=".update.UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Legacy: hands one verified APK to Android's installer (read-only, one-off grant); unused by the session path. -->
        <provider
            android:name=".update.ApkProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Share: one file the user shares from a chat, handed to the app they pick (read-only, one-off grant). -->
        <provider
            android:name=".share.OutShareProvider"
            android:authorities="${applicationId}.outshare"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Android Apps: install session results, and the background update job for apps Wizard OS installed. -->
        <receiver
            android:name=".apps.AppsInstallReceiver"
            android:exported="false" />
        <service
            android:name=".apps.AppsUpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
