# Copy to ios/fastlane/.env (git-ignored) and fill in. None of these are secrets except the .p8 file itself,
# which stays outside the repo (for example ~/.appstoreconnect/AuthKey_XXXXXXXXXX.p8, chmod 600).

# Apple Developer team ID (developer.apple.com → Membership details)
DEVELOPMENT_TEAM=
# Bundle ID registered for the app in that team (and the App Store Connect app record)
APP_IDENTIFIER=ai.wizards.os
# The Wizard the app opens by default (testers can change it in the app)
WIZARD_ORIGIN=https://wizard.tailc0f369.ts.net

# App Store Connect → Users and Access → Integrations → App Store Connect API (role: Admin, needed for cloud signing)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.appstoreconnect/AuthKey_XXXXXXXXXX.p8
