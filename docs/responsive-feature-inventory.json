{
  "purpose": "Every entrypoint-exclusive asset must be explicit; new common features must be shared by default, not added to these exceptions.",
  "exceptions": {
    "core/orb-handoff.js": {
      "shell": "phone",
      "classification": "open-gap",
      "reason": "Meeting-loan coordinator is currently wired only to the phone orb; desktop admission remains a separate acceptance gap, not claimed parity."
    },
